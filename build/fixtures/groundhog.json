    {
      "id": "canon",
      "title": "Groundhog Day (1993), theatrical cut",
      "kind": "canon_statement",
      "text": "Phil relives February 2 in Punxsutawney. His body resets; his memory persists. The film represents three iterations (opening day, an exhausted stretch, the changed man) of an uncounted larger number. No other world exists; the loop ends when his day stops repeating."
    },
    {
      "id": "allocation",
      "title": "Fixture allocations",
      "kind": "test_fixture",
      "text": "Iteration count beyond the three represented days is unknown and labeled as such. Rita fates are tracked per represented iteration."
    }
